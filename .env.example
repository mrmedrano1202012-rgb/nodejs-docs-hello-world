# Super Cleaners booking app — environment variables.
# Copy the ones you need into the Hostinger Node.js app's environment
# settings (hPanel). NEVER commit real values. Every group is optional:
# a missing group disables that feature and the app uses a safe fallback.

# --- Server ---
# PORT=3000                         # Hostinger sets this automatically.
# BUSINESS_TIMEZONE=America/Los_Angeles
# MIN_LEAD_MINUTES=120              # earliest bookable start = now + this
# MAX_ADVANCE_DAYS=60

# --- Storage (MySQL). If unset, bookings append to a local JSON file. ---
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DATA_DIR=./data                   # JSON fallback location

# --- Availability: Google Calendar free/busy ---
# Share the calendar with the service account, then set:
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=      # full service-account JSON (or base64)
# -- or the pair instead of the JSON blob:
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# --- Availability: dev / manual busy blocks (used when Google is unset,
#     and layered on top of Google when set). JSON array of ISO ranges,
#     or a data/dev-busy.json file with the same shape. ---
# DEV_BUSY_JSON=[{"start":"2026-10-16T15:00:00Z","end":"2026-10-16T18:00:00Z"}]

# --- Square card-on-file ---
# SQUARE_APPLICATION_ID=            # enables the browser card form
# SQUARE_LOCATION_ID=
# SQUARE_ACCESS_TOKEN=              # enables server-side card storage
# SQUARE_ENVIRONMENT=sandbox        # sandbox | production

# --- Notify John by email (SMTP) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=                  # John's inbox for new requests

# --- Notify John by SMS (Twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=               # e.g. +16613873892
# JOHN_NOTIFY_PHONE=                # John's mobile, E.164
